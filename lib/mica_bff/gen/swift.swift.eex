<%= @header %>

#if canImport(os)
import os
#endif

enum <%= @namespace %> {}

extension <%= @namespace %> {
    /// Reports a prop the server must send but didn't, or sent with a value that doesn't decode
    /// (`record` and `prop` are spec names; `prop` is "props" when a block or region came without
    /// its props object). The app still renders what it has (tolerant reader, ADR 0001); this makes
    /// the server bug or changed type visible. Logs an error to the unified log (to standard output
    /// where there is none, as on Linux); bind another reporter with
    /// `<%= @namespace %>.$reportMissing.withValue(...)`.
    @TaskLocal static var reportMissing: @Sendable (_ record: Swift.String, _ prop: Swift.String) -> Swift.Void = { record, prop in
        #if canImport(os)
        decodingLog.error("\(record, privacy: .public) has no \(prop, privacy: .public)")
        #else
        print("mica-bff decoding: \(record) has no \(prop)")
        #endif
    }

    #if canImport(os)
    private static let decodingLog = os.Logger(subsystem: "mica-bff", category: "decoding")
    #endif

    /// One block on a BFF page. Decoding never fails: a type this app doesn't know
    /// becomes `.unknown`, and a known block always decodes, with the props it could read.
    enum Block: Swift.Decodable, Swift.Equatable, Swift.Sendable {
<%= for block <- @blocks do %>        case <%= block.case %>(<%= block.type %>)
<% end %>        case unknown(type: Swift.String)

        private enum CodingKeys: Swift.String, Swift.CodingKey {
            case type, props
        }

        init(from decoder: any Swift.Decoder) throws {
            guard let container = try? decoder.container(keyedBy: CodingKeys.self),
                  let type = try? container.decode(Swift.String.self, forKey: .type)
            else {
                self = .unknown(type: "")
                return
            }
            switch type {
<%= for block <- @blocks do %>            case "<%= block.name %>":
                self = .<%= block.case %>((try? container.decode(<%= block.type %>.self, forKey: .props))
                    ?? { <%= @namespace %>.reportMissing("<%= block.name %>", "props"); return <%= block.none %> }())
<% end %>            default:
                self = .unknown(type: type)
            }
        }
    }

    /// A region of a page's markup: it covers the blocks from the one with id `start` to
    /// the one with id `end`, both included. Decoding fails without a string `start` and
    /// `end`, so a page drops the region; a kind this app doesn't know becomes `.unknown`.
    struct Region: Swift.Decodable, Swift.Equatable, Swift.Sendable {
        let start: Swift.String
        let end: Swift.String
        let kind: Kind

        enum Kind: Swift.Equatable, Swift.Sendable {
<%= for kind <- @regions do %>            case <%= kind.case %>(<%= kind.type %>)
<% end %>            case unknown(kind: Swift.String)
        }

        private enum CodingKeys: Swift.String, Swift.CodingKey {
            case kind, start, end, props
        }

        init(from decoder: any Swift.Decoder) throws {
            let container = try decoder.container(keyedBy: CodingKeys.self)
            start = try container.decode(Swift.String.self, forKey: .start)
            end = try container.decode(Swift.String.self, forKey: .end)
            let kind = (try? container.decode(Swift.String.self, forKey: .kind)) ?? ""
            switch kind {
<%= for kind <- @regions do %>            case "<%= kind.name %>":
                self.kind = .<%= kind.case %>((try? container.decode(<%= kind.type %>.self, forKey: .props))
                    ?? { <%= @namespace %>.reportMissing("<%= kind.name %>", "props"); return <%= kind.none %> }())
<% end %>            default:
                self.kind = .unknown(kind: kind)
            }
        }

        init(start: Swift.String, end: Swift.String, kind: Kind) {
            self.start = start
            self.end = end
            self.kind = kind
        }
    }

    /// A page in the nested form a client renders: a block with its id, or a region with
    /// what it covers.
    indirect enum Node: Swift.Equatable, Swift.Sendable {
        case block(id: Swift.String?, Block)
        case region(Region, [Node])
    }

    /// A page as the BFF sends it: its blocks, each block's id (`nil` when it has none) and
    /// its markup: the regions beside them.
    struct Page: Swift.Decodable, Swift.Equatable, Swift.Sendable {
        let blocks: [Block]
        let ids: [Swift.String?]
        let markup: [Region]

        private enum CodingKeys: Swift.String, Swift.CodingKey {
            case blocks, markup
        }

        /// A block with its id, as it is in `blocks` on the wire.
        private struct Item: Swift.Decodable {
            let id: Swift.String?
            let block: Block

            private enum CodingKeys: Swift.String, Swift.CodingKey {
                case id
            }

            init(from decoder: any Swift.Decoder) throws {
                id = try? decoder.container(keyedBy: CodingKeys.self).decodeIfPresent(Swift.String.self, forKey: .id)
                block = try Block(from: decoder)
            }
        }

        init(from decoder: any Swift.Decoder) throws {
            let container = try decoder.container(keyedBy: CodingKeys.self)
            let items = (try? container.decodeIfPresent([Item].self, forKey: .blocks)) ?? []
            blocks = items.map(\.block)
            ids = items.map(\.id)
            markup = (try? container.decodeIfPresent(LossyList<Region>.self, forKey: .markup))?.values ?? []
        }

        init(blocks: [Block], ids: [Swift.String?], markup: [Region]) {
            self.blocks = blocks
            self.ids = ids
            self.markup = markup
        }

        /// How deep regions may nest (ADR 0001): `tree()` and the views after it recurse once
        /// per level, so a limit keeps deep markup from overflowing the stack.
        static let maxRegionDepth = <%= @max_region_depth %>

        /// Why the markup doesn't hold, for the first region that doesn't, or nil when it does:
        /// a region whose `start` or `end` is no block's id or an id two blocks have, one
        /// that ends before it starts, one that crosses a region before it, or one that would
        /// make regions nest deeper than `maxRegionDepth`. Regions nest as in XML: two regions
        /// share no block, or one covers all of the other. Regions of a kind this app doesn't
        /// know are left out.
        func check() -> Swift.String? {
            let positions = idPositions()
            var kept: [Span] = []
            for region in known {
                if let problem = keep(region, positions, &kept) { return problem.reason }
            }
            return nil
        }

        /// The page as the nested tree to render, in page order. Regions over the same
        /// stretch nest in list order, the first outermost. A region of a kind this app
        /// doesn't know, or one that `check()` refuses, is left out, and its blocks still show.
        func tree() -> [Node] {
            let positions = idPositions()
            var kept: [Span] = []
            for region in known {
                _ = keep(region, positions, &kept)
            }
            // Outermost first: by start, the longest first, then in list order.
            let spans = kept.enumerated()
                .sorted { ($0.element.first, -$0.element.last, $0.offset) < ($1.element.first, -$1.element.last, $1.offset) }
                .map(\.element)
            var next = 0
            func nodes(_ from: Swift.Int, _ to: Swift.Int) -> [Node] {
                var result: [Node] = []
                var position = from
                while position < to {
                    if next < spans.count, spans[next].first == position {
                        let span = spans[next]
                        next += 1
                        result.append(.region(span.region, nodes(position, span.last + 1)))
                        position = span.last + 1
                    } else {
                        result.append(.block(id: position < ids.count ? ids[position] : nil, blocks[position]))
                        position += 1
                    }
                }
                return result
            }
            return nodes(0, blocks.count)
        }

        private struct Span {
            let region: Region
            let first: Swift.Int
            let last: Swift.Int
            /// How many regions this one is in, itself included.
            var depth: Swift.Int
        }

        private struct Problem: Swift.Error {
            let reason: Swift.String
        }

        private var known: [Region] {
            markup.filter { if case .unknown = $0.kind { false } else { true } }
        }

        /// Where each id is on the page; nil for an id two blocks have.
        private func idPositions() -> [Swift.String: Swift.Int?] {
            var positions: [Swift.String: Swift.Int?] = [:]
            for (position, id) in ids.prefix(blocks.count).enumerated() {
                guard let id else { continue }
                if positions[id] == nil {
                    positions[id] = position
                } else {
                    positions.updateValue(nil, forKey: id)
                }
            }
            return positions
        }

        private func position(_ id: Swift.String, _ positions: [Swift.String: Swift.Int?]) -> Swift.Result<Swift.Int, Problem> {
            switch positions[id] {
            case let position??: return .success(position)
            case .some(.none): return .failure(Problem(reason: "two blocks have id \"\(id)\""))
            case .none: return .failure(Problem(reason: "\"\(id)\" is no block's id"))
            }
        }

        /// Adds `region` to `kept` when it nests with them and keeps every region within
        /// `maxRegionDepth`, or says why not. The regions around it set its depth; the ones it
        /// goes around get one deeper (one over the same stretch before it is around it).
        private func keep(_ region: Region, _ positions: [Swift.String: Swift.Int?], _ kept: inout [Span]) -> Problem? {
            let found: Span
            switch span(region, positions, kept) {
            case .success(let span): found = span
            case .failure(let problem): return problem
            }
            let (first, last) = (found.first, found.last)
            // ponytail: one pass over `kept` per region, quadratic in kept regions (as the crossing
            // check); an interval tree if a page ever sends thousands of side-by-side regions.
            var around = 0
            var deepestInside = 0
            var goesAround = false
            for span in kept {
                if span.first <= first && last <= span.last {
                    around += 1
                } else if first <= span.first && span.last <= last {
                    deepestInside = Swift.max(deepestInside, span.depth + 1)
                    goesAround = true
                }
            }
            let deepest = Swift.max(around + 1, deepestInside)
            if deepest > Self.maxRegionDepth {
                return Problem(reason: "region from \"\(region.start)\" to \"\(region.end)\": regions would nest \(deepest) deep, more than \(Self.maxRegionDepth)")
            }
            if goesAround {
                for index in kept.indices
                where first <= kept[index].first && kept[index].last <= last
                    && (kept[index].first, kept[index].last) != (first, last) {
                    kept[index].depth += 1
                }
            }
            kept.append(Span(region: region, first: first, last: last, depth: around + 1))
            return nil
        }

        /// The positions a region covers, when it nests with the regions `kept` before it.
        private func span(_ region: Region, _ positions: [Swift.String: Swift.Int?], _ kept: [Span]) -> Swift.Result<Span, Problem> {
            let name = "region from \"\(region.start)\" to \"\(region.end)\""
            let first: Swift.Int
            let last: Swift.Int
            switch (position(region.start, positions), position(region.end, positions)) {
            case (.failure(let problem), _), (.success, .failure(let problem)):
                return .failure(Problem(reason: "\(name): \(problem.reason)"))
            case (.success(let start), .success(let end)):
                first = start
                last = end
            }
            if last < first { return .failure(Problem(reason: "\(name): it ends before it starts")) }
            let crossed = kept.first { span in
                (span.first < first && first <= span.last && span.last < last)
                    || (first < span.first && span.first <= last && last < span.last)
            }
            if let crossed {
                return .failure(Problem(reason: "\(name) crosses the region from \"\(crossed.region.start)\" to \"\(crossed.region.end)\""))
            }
            return .success(Span(region: region, first: first, last: last, depth: 0))
        }
    }
<%= for source <- @structs do %>
<%= source %>
<% end %>
    /// A list prop: an element that doesn't decode (a changed type, `null`) is dropped
    /// and the rest of the list stays (ADR 0001).
    struct LossyList<Element: Swift.Decodable>: Swift.Decodable {
        let values: [Element]

        init(from decoder: any Swift.Decoder) throws {
            var container = try decoder.unkeyedContainer()
            var values: [Element] = []
            while !container.isAtEnd {
                if try container.decodeNil() { continue }
                if let value = try? container.decode(Element.self) {
                    values.append(value)
                } else {
                    _ = try container.decode(Skip.self)
                }
            }
            self.values = values
        }

        /// Decodes from any value without reading it: moves past an element that didn't decode.
        private struct Skip: Swift.Decodable {
            init(from decoder: any Swift.Decoder) {}
        }
    }
}
<%= for record <- @decoders do %>
<%= record.comment %>
extension <%= @namespace %>.<%= record.type %> {
    init(from decoder: any Swift.Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
<%= for field <- record.fields do %>        self.<%= field.ident %> = <%= field.decode %>
<% end %><%= for field <- record.fields, field.required do %>        if self.<%= field.ident %> == nil { <%= @namespace %>.reportMissing("<%= record.name %>", "<%= field.name %>") }
<% end %>    }
}
<% end %>
